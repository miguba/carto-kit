---
import '@/styles/global.css';
import { getSiteChrome } from '@/lib/site-chrome';
import { getSiteUrl } from '@/lib/config';

type Props = {
  title: string;
  description?: string;
  checkoutOnly?: boolean;
  /** Path for canonical URL (e.g. '/' or '/privacy-policy'). Defaults to current pathname without query params. */
  canonicalPath?: string;
  /** Full URL or path for og:image. Falls back to /ms365-logo.png. */
  ogImage?: string;
  /** Open Graph type. Defaults to 'website'. */
  ogType?: string;
  /** If true, adds noindex/nofollow robots meta. */
  noindex?: boolean;
  /** Extra JSON-LD structured data objects to inject into the page. */
  jsonLd?: Record<string, unknown>[];
};

const {
  title,
  description = '365 Deal — Microsoft 365 digital subscriptions and secure checkout.',
  checkoutOnly = false,
  canonicalPath,
  ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
} = Astro.props;
const siteChrome = await getSiteChrome();
const siteUrl = getSiteUrl();
const resolvedCanonicalPath = canonicalPath ?? Astro.url.pathname;
const canonicalUrl = `${siteUrl}${resolvedCanonicalPath}`;
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`)
  : `${siteUrl}/ms365-logo.png`;

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '365 Deal',
  url: siteUrl,
  logo: `${siteUrl}/ms365-logo.png`,
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'support@office.dibsale.com',
    contactType: 'customer service',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:site_name" content="365 Deal" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <title>{title}</title>

    <!-- Organization JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    {jsonLd.map((data) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body>
    <div class="min-h-screen">
      {
        checkoutOnly ? null : (
          <header class="bg-transparent">
            <a
              class="block bg-[#1673b1] text-white! text-center text-base font-extralight py-1"
              href="/#buy"
            >
              Claim Your Flash Deal - Up To 50% Off Today!
            </a>

            <nav
              class="mx-auto flex min-h-[92px] w-[calc(100%-32px)] max-w-6xl items-center justify-center gap-4 max-[760px]:min-h-[76px] py-5"
              aria-label="Main navigation"
            >
              <a
                class="inline-flex items-center no-underline"
                href="/"
                aria-label="365 Deal home"
              >
                <img
                  class="h-auto w-[252px] object-contain max-[760px]:w-[190px]"
                  src="/ms365-logo.png"
                  alt="365 Deal"
                />
              </a>
              <div class="hidden" aria-label="Page sections">
                <a href="/">Home</a>
                <a href="/#description">Description</a>
                <a href="/#faq">FAQ</a>
              </div>
            </nav>
          </header>
        )
      }

      <main class="wrap">
        <slot />
      </main>

      <footer
        class="bg-white py-7 text-center font-rl pt-12"
        aria-label="Footer"
      >
        <div class="mx-auto grid w-[calc(100%-32px)] max-w-6xl gap-[22px]">
          <div
            class="flex items-center justify-center gap-1.5 text-sm leading-none"
          >
            <img
              class="h-[14px] w-[14px] object-contain"
              src={siteChrome.footerIcon}
              alt=""
              aria-hidden="true"
            />
            <span class="font-rm text-[#555]">
              {siteChrome.footerPoweredByLabel}
            </span>
            <span class="text-[#111]">{siteChrome.footerBrandName}</span>
          </div>
          <nav
            class="flex flex-wrap justify-center gap-x-[18px] gap-y-2 text-sm leading-[1.2]"
            aria-label="Footer links"
          >
            {
              siteChrome.footerLinks.map((link) => (
                <a
                  class="font-normal text-[#7a7a7a] no-underline hover:text-[#0b67a3] hover:underline"
                  href={link.href}
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
          <p class="m-0 text-xs leading-[1.2] text-[#7a7a7a]">
            {siteChrome.footerCopyright}
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
