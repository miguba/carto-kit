---
import PolicyPage from '@/components/PolicyPage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import defaultPolicyMarkdown from '@/content/policies/contact-us.md?raw';
import { getCommerceConfigFromServer } from '@/lib/commerce';
import { loadPolicyBlock } from '@/lib/policy-block';

const POLICY_BLOCK_KEY = 'contact-us';

const { site } = await getCommerceConfigFromServer();

const policy = await loadPolicyBlock({
  key: POLICY_BLOCK_KEY,
  defaultMarkdown: defaultPolicyMarkdown,
  fallbackTitle: 'Contact Us',
  fallbackIntro:
    'Need help with an order or a policy question? Send us the details and we will help you find the cleanest path forward.',
  fallbackDescription: `Contact ${site.name} support for order help, payment questions, digital delivery updates, and refund requests.`,
  siteName: site.name,
  variables: {
    siteName: site.name,
    supportEmail: site.supportEmail,
  },
});
---

<BaseLayout
  title={`${policy.seoTitle} | ${site.name}`}
  description={policy.pageDescription}
  canonicalPath="/contact-us"
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: policy.title,
    description: policy.pageDescription,
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
        { '@type': 'ListItem', position: 2, name: policy.title },
      ],
    },
  }]}
>
  <PolicyPage
    eyebrow={policy.eyebrow}
    title={policy.title}
    intro={policy.intro}
    updated={policy.updated}
    contentHtml={policy.contentHtml}
    contentHeadings={policy.contentHeadings}
    asideTitle={policy.asideTitle}
    asideText={policy.asideText}
    contactMethods={policy.contactMethods}
  />
</BaseLayout>
