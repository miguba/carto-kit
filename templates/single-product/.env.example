EMS_SITE_DOMAIN=__EMS_SITE_DOMAIN__
PUBLIC_SITE_URL=__PUBLIC_SITE_URL__
PRODUCT_DETAIL_URL_TEMPLATE=/products/{slug}

# SSR only. Do not expose this to browser bundles.
EMS_SERVER_APP_TOKEN=

# Frontend build mode: ssr or static.
FRONTEND_MODE=__FRONTEND_MODE__

# VPS deploy
VPS_HOST=
VPS_PORT=22
VPS_USER=ubuntu
VPS_SSH_KEY=
VPS_DEPLOY_DIR=/var/www/ems-storefront
VPS_PM2_APP_NAME=ems-storefront
VPS_APP_PORT=4321
# Comma-separated domains are supported, for example: example.com, www.example.com
VPS_CADDY_DOMAIN=__EMS_SITE_DOMAIN__
