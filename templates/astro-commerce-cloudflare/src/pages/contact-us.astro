---
import PolicyPage from '@/components/PolicyPage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteConfig } from '@/lib/config';

const site = getSiteConfig();

const contactMethods = [
  { label: 'Email', value: site.supportEmail, href: `mailto:${site.supportEmail}` },
  { label: 'Response time', value: site.supportResponseTime },
  { label: 'Policy help', value: 'Return policy', href: '/cancellation-refund-policy' },
];

const sections = [
  {
    title: 'Customer Support',
    body: 'For order questions, payment confirmation, delivery updates, refund reviews, or product support, email our team with your order number and the email address used at checkout.',
  },
  {
    title: 'What to Include',
    items: [
      'Your order number, if you have one.',
      'The email address used during checkout.',
      'A short description of the issue or request.',
      'Screenshots or payment references when they help us verify the problem.',
    ],
  },
  {
    title: 'Billing and Payment Help',
    body: 'If your payment appears pending, duplicated, declined, or charged incorrectly, contact us before opening a dispute so we can check the order and payment logs.',
  },
  {
    title: 'Refund Requests',
    body: 'Return and refund requests are reviewed under our Return & Refund Policy. We may ask for additional details before approving or declining a request.',
  },
  {
    title: 'Business Information',
    items: [
      `Company: ${site.legalName}`,
      `Website: ${site.domain}`,
      `Support email: ${site.supportEmail}`,
      'Add your registered business number and address before publishing this page.',
    ],
  },
];
---

<BaseLayout
  title={`Contact Us | ${site.name}`}
  description={`Contact ${site.name} support for order help, payment questions, delivery updates, and refund requests.`}
>
  <PolicyPage
    eyebrow="Support"
    title="Contact Us"
    intro="Need help with an order or a policy question? Send us the details and we will help you find the cleanest path forward."
    updated={site.policyUpdatedAt}
    sections={sections}
    asideTitle="Support mailbox"
    asideText="For the fastest review, include your order number and the checkout email address."
    contactMethods={contactMethods}
  />
</BaseLayout>
