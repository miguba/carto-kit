---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchProduct, fetchProducts } from "../../lib/ems";
import { getInventoryLabel, getProductImages, getProductPrice } from "../../lib/products";

export const prerender = import.meta.env.FRONTEND_MODE === "static";

export async function getStaticPaths() {
  if (import.meta.env.FRONTEND_MODE !== "static") return [];
  const products = await fetchProducts();
  return products.map((product) => ({ params: { slug: product.slug } }));
}

const { slug } = Astro.params;
const product = slug ? await fetchProduct(slug) : null;

if (!product) {
  return Astro.redirect("/", 302);
}

const images = getProductImages(product);
const [mainImage] = images;
---
<BaseLayout title={product.title} description={product.summary || product.description}>
  <section class="product-detail">
    <div class="product-gallery">
      <div class="product-gallery__main">
        {mainImage ? <img src={mainImage.url} alt={mainImage.alt || product.title} /> : <div class="image-placeholder">No image</div>}
      </div>
      {images.length > 1 && (
        <div class="product-gallery__thumbs">
          {images.slice(1, 5).map((image) => <img src={image.url} alt={image.alt || product.title} loading="lazy" />)}
        </div>
      )}
    </div>

    <article class="purchase-panel">
      <p class="eyebrow">{getInventoryLabel(product)}</p>
      <h1>{product.title}</h1>
      <p class="price">{getProductPrice(product)}</p>
      {product.description && <p class="description">{product.description}</p>}

      {product.sellingPoints && product.sellingPoints.length > 0 && (
        <ul class="selling-points">
          {product.sellingPoints.map((point) => <li>{point}</li>)}
        </ul>
      )}

      {product.variants && product.variants.length > 0 && (
        <div class="variants">
          <label for="variant">Variant</label>
          <select id="variant" name="variant">
            {product.variants.map((variant) => (
              <option value={variant.id}>{variant.title || variant.sku || variant.id}</option>
            ))}
          </select>
        </div>
      )}

      <a class="button" href={`/checkout/${product.slug}`}>Checkout</a>
    </article>
  </section>
</BaseLayout>
