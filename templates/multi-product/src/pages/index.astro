---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProducts } from '@/lib/commerce';
import { getSiteConfigFromServer } from '@/lib/commerce';
import { IMAGE_PRESETS, formatMoney, imageSrcSet, optimizedImageUrl, productCardPrice, productImages, productSellingPoints, productTrustSignals, productVideo } from '@/lib/format';
import type { Product } from '@/lib/types';

export const prerender = false;

const site = await getSiteConfigFromServer();
let products: Product[] = [];
let featuredProduct: Product | null = null;
let loadError = '';

try {
  products = await getProducts(12);
  featuredProduct = products[0] ?? null;
} catch (error) {
  loadError = error instanceof Error ? error.message : 'Unable to load products.';
}

const productCount = products.length;
const totalStock = products.reduce((sum, item) => sum + item.totalStock, 0);
const supportItems = [
  {
    title: 'Shop with Confidence',
    body: 'Every order is verified and handled with care — from product selection to delivery confirmation, we make sure your experience is worry-free.',
    icon: 'package-check',
    tone: 'amber',
  },
  {
    title: 'Handpicked, Not Heaped',
    body: 'We curate a focused catalog so you spend less time browsing and more time enjoying. Every product earns its spot in the box.',
    icon: 'sparkles',
    tone: 'teal',
  },
  {
    title: 'Safe & Seamless Checkout',
    body: 'One-page checkout with transparent pricing, multiple payment options, and real human support — because trust is the best feature.',
    icon: 'shield-check',
    tone: 'blue',
  },
];
---

<BaseLayout
  title={`${site.name} | Genuine Products, Instant Joy`}
  description={`${site.name} — Handpicked products at unbeatable prices. Genuine quality, fast delivery, and a checkout experience that sparks joy.`}
>
  {
    featuredProduct ? (
      <>
        <section class="catalog-hero">
          <div class="container marketplace-hero">
            <div class="marketplace-hero-banner">
              <div class="marketplace-hero-copy">
                <p class="eyebrow">Genuine products, curated for you</p>
                <h1>Your joy starts here — genuine products at prices worth smiling about.</h1>
                <p>
                  Handpicked products with fast delivery, transparent pricing, and real support. Every purchase is a moment of joy designed to delight.
                </p>
                <div class="marketplace-hero-actions">
                  <a class="primary-button" href="#products">Shop the collection</a>
                  <a class="secondary-button" href="/contact-us">Need help?</a>
                </div>
              </div>
              <div class="marketplace-hero-media">
                {productImages(featuredProduct)[0] ? (
                  <img
                    src={optimizedImageUrl(productImages(featuredProduct)[0], IMAGE_PRESETS.card)}
                    srcset={imageSrcSet(productImages(featuredProduct)[0], [360, 520, 720], { quality: IMAGE_PRESETS.card.quality })}
                    sizes="(min-width: 981px) 360px, 60vw"
                    alt={featuredProduct.title}
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                  />
                ) : (
                  <span aria-hidden="true">{featuredProduct.title.slice(0, 1).toUpperCase()}</span>
                )}
              </div>
            </div>

            <aside class="marketplace-buy-box" aria-label="Featured deal">
              <p class="eyebrow">Today's top pick</p>
              <h2>{featuredProduct.title}</h2>
              <div class="marketplace-buy-box-price">
                <strong>{formatMoney(featuredProduct.minPrice, featuredProduct.currency)}</strong>
                <span>{featuredProduct.totalStock > 0 ? `${featuredProduct.totalStock} in stock` : 'Out of stock'}</span>
              </div>
              <a class="buy-button" href={`/products/${featuredProduct.slug}`}>Grab this deal</a>
              <dl>
                <div>
                  <dt>Products</dt>
                  <dd>{productCount}</dd>
                </div>
                <div>
                  <dt>Available</dt>
                  <dd>{totalStock}</dd>
                </div>
                <div>
                  <dt>Payment</dt>
                  <dd>Secure</dd>
                </div>
              </dl>
            </aside>
          </div>
        </section>

        <section class="catalog-results" id="products">
          <div class="container catalog-results-shell">
            <div class="catalog-results-main">
              <div class="catalog-toolbar">
                <div>
                  <p class="eyebrow">The {site.name} collection</p>
                  <h2>Every order holds something worth discovering</h2>
                  <span>{productCount} products, {totalStock} units currently available.</span>
                </div>
              </div>

              <div class="catalog-product-grid">
                {products.map((item, index) => {
                  const image = productImages(item)[0];
                  const video = productVideo(item);
                  const trust = productTrustSignals(item);
                  const price = productCardPrice(item);
                  const sellingPoint = productSellingPoints(item)[0];

                  return (
                  <a class="catalog-card" href={`/products/${item.slug}`}>
                    <div class={video ? 'media-frame catalog-card-art has-video image-placeholder-frame' : 'media-frame catalog-card-art image-placeholder-frame'}>
                      {video ? (
                        <>
                          <video
                            aria-label={`${item.title} video preview`}
                            loop
                            muted
                            playsinline
                            poster={optimizedImageUrl(image, IMAGE_PRESETS.card)}
                            preload="none"
                            data-preview-video={video}
                          >
                          </video>
                          <span class="video-badge" aria-hidden="true">Video</span>
                        </>
                      ) : image ? (
                        <img
                          src={optimizedImageUrl(image, IMAGE_PRESETS.card)}
                          srcset={imageSrcSet(image, [360, 480, 720], { quality: IMAGE_PRESETS.card.quality })}
                          sizes="(min-width: 1024px) 230px, (min-width: 640px) 280px, calc(100vw - 32px)"
                          alt={item.title}
                          loading={index < 2 ? 'eager' : 'lazy'}
                          decoding="async"
                          fetchpriority={index === 0 ? 'high' : 'auto'}
                        />
                      ) : (
                        <span aria-hidden="true">{item.title.slice(0, 1).toUpperCase()}</span>
                      )}
                    </div>
                    <div class="catalog-card-trust" aria-label={`${trust.rating} stars, ${trust.soldText}`}>
                      <span aria-hidden="true">★★★★★</span>
                      <strong>{trust.rating}</strong>
                      <em>{trust.soldText}</em>
                    </div>
                    <div class="catalog-card-body grid gap-2">
                      <h3>{item.title}</h3>
                      {sellingPoint ? <p>{sellingPoint}</p> : null}
                    </div>
                    <div class="catalog-card-footer mt-auto pt-3 border-t border-line">
                      <div class="catalog-price-stack">
                        <strong>{formatMoney(price.price, item.currency)}</strong>
                        {price.compareAtPrice ? (
                          <span>
                            <del>{formatMoney(price.compareAtPrice, item.currency)}</del>
                            {price.discountPercent ? <em>{price.discountPercent}% off</em> : null}
                          </span>
                        ) : null}
                      </div>
                    </div>
                  </a>
                  );
                })}
              </div>
            </div>
          </div>
        </section>

        <section class="section-tight support-band" id="support">
          <div class="container support-grid">
            {supportItems.map((item) => (
              <article>
                <div class="support-card-heading">
                  <span class={`support-icon ${item.tone}`} aria-hidden="true">
                    {item.icon === 'package-check' ? (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m16 16 2 2 4-4" />
                        <path d="M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14" />
                        <path d="m7.5 4.27 9 5.15" />
                        <path d="M3.29 7 12 12l8.71-5" />
                        <path d="M12 22V12" />
                      </svg>
                    ) : item.icon === 'sparkles' ? (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9.94 14.44 8 21l-1.94-6.56L0 12l6.06-2.44L8 3l1.94 6.56L16 12l-6.06 2.44Z" />
                        <path d="M19 3v4" />
                        <path d="M21 5h-4" />
                        <path d="M20 15v3" />
                        <path d="M21.5 16.5h-3" />
                      </svg>
                    ) : (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.68 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1v7Z" />
                        <path d="m9 12 2 2 4-4" />
                      </svg>
                    )}
                  </span>
                  <h3>{item.title}</h3>
                </div>
                <p>{item.body}</p>
              </article>
            ))}
          </div>
        </section>
      </>
    ) : (
      <section class="error-state">
        <div class="panel error-panel max-w-2xl text-center">
          <p class="eyebrow">Catalog unavailable</p>
          <h1>We could not load the store products.</h1>
          <p>{loadError}</p>
          <p>
            Check <code>COMMERCE_API_TOKEN</code> and the product API.
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion) {
    document.querySelectorAll<HTMLAnchorElement>('.catalog-card').forEach((card) => {
      const video = card.querySelector<HTMLVideoElement>('[data-preview-video]');

      if (!video) {
        return;
      }

      const videoSrc = video.dataset.previewVideo;
      const play = () => {
        if (videoSrc && !video.querySelector('source')) {
          const source = document.createElement('source');
          source.src = videoSrc;
          video.append(source);
          video.load();
        }

        video.muted = true;
        video.play().catch(() => undefined);
      };

      const pause = () => {
        if (!video.autoplay) {
          video.pause();
        }
      };

      card.addEventListener('pointerenter', play);
      card.addEventListener('focusin', play);
      card.addEventListener('pointerleave', pause);
      card.addEventListener('focusout', pause);
    });
  }
</script>
