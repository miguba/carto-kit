---
import PolicyPage from "@/components/PolicyPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import defaultPolicyMarkdown from "@/content/policies/shipping-policy.md?raw";
import { getSiteConfigFromServer } from "@/lib/commerce";
import { loadPolicyBlock } from "@/lib/policy-block";
import { siteAbsoluteUrl } from "@/lib/seo";

export const prerender = false;

const POLICY_BLOCK_KEY = "shipping-policy";

const refreshCache = Astro.url.searchParams.get("___refresh___") === "1";
const site = await getSiteConfigFromServer({ refresh: refreshCache });
const canonicalUrl = siteAbsoluteUrl("/shipping-policy", site.domain, Astro.url.origin);

const contactMethods = [
  {
    label: "Shipping questions",
    value: site.supportEmail,
    href: `mailto:${site.supportEmail}`,
  },
  { label: "Order tracking", value: "Contact us", href: "/contact-us" },
];

const policy = await loadPolicyBlock({
  key: POLICY_BLOCK_KEY,
  defaultMarkdown: defaultPolicyMarkdown,
  fallbackTitle: "Shipping Policy",
  fallbackIntro:
    "Everything you need to know about our shipping process, estimated delivery times, and how to track your order.",
  fallbackDescription: `Learn about ${site.name} shipping times, delivery coverage, tracking, and free shipping details.`,
  siteName: site.name,
  refresh: refreshCache,
});

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteAbsoluteUrl("/", site.domain, Astro.url.origin),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: policy.title,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={`${policy.seoTitle} | ${site.name}`}
  description={policy.pageDescription}
  canonicalUrl={canonicalUrl}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <PolicyPage
    eyebrow={policy.eyebrow}
    title={policy.title}
    intro={policy.intro}
    updated={policy.updated}
    contentHtml={policy.contentHtml}
    contentHeadings={policy.contentHeadings}
    asideTitle={policy.asideTitle}
    asideText={policy.asideText}
    contactMethods={contactMethods}
  />
</BaseLayout>
