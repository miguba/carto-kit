---
import "@/styles/global.css";
import { getSiteConfigFromServer } from "@/lib/commerce";
import { getBrandLogo } from "@/lib/brand";

type Props = {
  title: string;
  description?: string;
  canonicalUrl?: string;
  checkoutOnly?: boolean;
  image?: string;
  keywords?: string[];
  lang?: string;
  noindex?: boolean;
  type?: "website" | "article" | "product";
};

const refreshCache = Astro.url.searchParams.get("___refresh___") === "1";
const site = await getSiteConfigFromServer({ refresh: refreshCache });
const {
  title,
  description = `${site.name} — Genuine products, fast delivery, and a checkout experience that sparks joy.`,
  canonicalUrl,
  checkoutOnly = false,
  image,
  keywords = [],
  lang = "en",
  noindex = false,
  type = "website",
} = Astro.props;
const brandLogo = getBrandLogo(site);
const demoFooterYear = "2026";
const demoFooterAddress = "123 Demo Street, Suite 100, Hong Kong";
const metaKeywords = keywords
  .map((keyword) => keyword.trim())
  .filter(Boolean)
  .join(", ");
const googleGtmId = normalizeGoogleGtmId(site.google?.gtmId);
const googleGtmScript = googleGtmId
  ? `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',${JSON.stringify(googleGtmId)});`
  : "";

function normalizeGoogleGtmId(value: string | null | undefined) {
  const id = value?.trim().toUpperCase();
  return id && /^GTM-[A-Z0-9]+$/.test(id) ? id : "";
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {metaKeywords ? <meta name="keywords" content={metaKeywords} /> : null}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    {image ? <meta property="og:image" content={image} /> : null}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image ? <meta name="twitter:image" content={image} /> : null}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{title}</title>
    {
      googleGtmScript ? (
        <script is:inline set:html={googleGtmScript} />
      ) : null
    }
  </head>
  <body>
    {
      googleGtmId ? (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${encodeURIComponent(googleGtmId)}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      ) : null
    }
    <div class="site-shell grid min-h-screen grid-rows-[auto_1fr_auto]">
      {
        checkoutOnly ? null : (
          <header class="site-header">
            <nav class="container nav" aria-label="Main navigation">
              <a class="brand-lockup" href="/">
                <img
                  class="brand-logo"
                  src={brandLogo.src}
                  alt={brandLogo.alt}
                />
              </a>
              <div class="nav-primary-links" aria-label="Primary">
                <a href="/#products">Products</a>
                <a href="/#support">Support</a>
                <a href="/cancellation-refund-policy">Returns</a>
              </div>
              <div class="nav-actions" aria-label="Store actions">
                <a class="nav-help-link" href="/contact-us">
                  <span>Secure checkout</span>
                  <strong>Help available</strong>
                </a>
                <a class="nav-shop-button" href="/#products">
                  View products
                </a>
                <details class="mobile-nav-menu">
                  <summary aria-label="Open navigation menu">
                    <span aria-hidden="true" />
                    <span aria-hidden="true" />
                    <span aria-hidden="true" />
                  </summary>
                  <div class="mobile-nav-panel" aria-label="Mobile navigation">
                    <a href="/#products">Products</a>
                    <a href="/#support">Support</a>
                    <a href="/cancellation-refund-policy">Returns</a>
                  </div>
                </details>
              </div>
            </nav>
          </header>
        )
      }
      <main>
        <slot />
      </main>
      {
        checkoutOnly ? null : (
          <footer class="site-footer" aria-label="Footer">
            <div class="container footer-hero grid gap-6 mb-12 pb-12 border-b border-white/12">
              <p class="eyebrow">{site.name}</p>
              <h2>Genuine products. Instant delivery. Joy in every order.</h2>
              <a class="secondary-button w-fit" href="/#products">
                Explore the collection
              </a>
            </div>
            <div class="container footer-grid grid gap-8 mb-12">
              <div class="footer-brand-col grid gap-5 content-start">
                <a
                  class="brand-lockup footer-logo inline-flex items-center gap-3 text-white font-black no-underline font-display text-2xl"
                  href="/"
                >
                  <img
                    class="brand-logo"
                    src={brandLogo.lightSrc}
                    alt={brandLogo.alt}
                  />
                </a>
                <p class="footer-slogan">
                  Genuine products, handpicked and delivered fast — with secure
                  checkout and real human support when you need it.
                </p>
              </div>

              <div class="footer-care-panel">
                <div>
                  <h3>Customer Care</h3>
                  <p>
                    Order questions, payment help, and store policies in one
                    place.
                  </p>
                </div>
                <div class="footer-policy-links grid gap-2.5 content-start">
                  <a href="/contact-us">Contact Support</a>
                  <a href="/shipping-policy">Shipping Policy</a>
                  <a href="/cancellation-refund-policy">
                    Return & Refund Policy
                  </a>
                  <a href="/terms-conditions">Terms of Service</a>
                  <a href="/privacy-policy">Privacy &amp; Cookie Policy</a>
                </div>
              </div>
            </div>

            <div class="container footer-bottom mt-12 pt-8 border-t border-white/12">
              <div class="footer-bottom-inner flex items-center justify-between gap-4">
                <div>
                  <p>
                    &copy; {demoFooterYear} {site.legalName}. All Rights
                    Reserved.
                  </p>
                  <p class="footer-registered-address">{demoFooterAddress}</p>
                </div>
                <div class="footer-payment-badges flex items-center gap-2 text-sm">
                  <span>Secure checkout via</span>
                  <strong>
                    Pay<span>Pal</span>
                  </strong>
                </div>
              </div>
            </div>
          </footer>
        )
      }
    </div>
  </body>
</html>
