{
  "name": "carto-kit-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Carto monorepo",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm --workspace carto-kit run build",
    "check": "npm --workspace carto-kit run check",
    "release:npm": "node scripts/release-npm.mjs",
    "test": "npm --workspace carto-kit run test && npm run check && npm --prefix templates/single-product run check && npm --prefix templates/multi-product run check"
  },
  "workspaces": [
    "packages/carto-kit"
  ],
  "packageManager": "npm@11.9.0",
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
