{
  "name": "carto-kit",
  "version": "0.1.24",
  "description": "Connect Carto Frontsite projects to Carto Private",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguba/carto-kit.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "carto": "dist/cli.js",
