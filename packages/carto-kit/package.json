    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.5.1",
    "@inquirer/prompts": "^7.3.2",
    "kleur": "^4.1.5",
    "wrangler": "4.118.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.6"
  }
}
