---
import PolicyPage from "@/components/PolicyPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import defaultPolicyMarkdown from "@/content/policies/privacy-policy.md?raw";
import { getSiteConfigFromServer } from "@/lib/commerce";
import { loadPolicyBlock } from "@/lib/policy-block";
import { siteAbsoluteUrl } from "@/lib/seo";

export const prerender = false;

const POLICY_BLOCK_KEY = "privacy-policy";

const site = await getSiteConfigFromServer();
const canonicalUrl = siteAbsoluteUrl("/privacy-policy", site.domain, Astro.url.origin);

const contactMethods = [
  { label: "Privacy requests", value: site.supportEmail, href: `mailto:${site.supportEmail}` },
  { label: "General support", value: site.supportEmail, href: `mailto:${site.supportEmail}` },
];

const policy = await loadPolicyBlock({
  key: POLICY_BLOCK_KEY,
  defaultMarkdown: defaultPolicyMarkdown,
  fallbackTitle: "Privacy Policy",
  fallbackIntro:
    "This policy explains what information we collect, why we collect it, and how you can contact us about your privacy choices.",
  fallbackDescription: `Learn how ${site.name} collects, uses, protects, and shares customer information.`,
  siteName: site.name,
});

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteAbsoluteUrl("/", site.domain, Astro.url.origin),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: policy.title,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={`${policy.seoTitle} | ${site.name}`}
  description={policy.pageDescription}
  canonicalUrl={canonicalUrl}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <PolicyPage
    eyebrow={policy.eyebrow}
    title={policy.title}
    intro={policy.intro}
    updated={policy.updated}
    contentHtml={policy.contentHtml}
    contentHeadings={policy.contentHeadings}
    asideTitle={policy.asideTitle}
    asideText={policy.asideText}
    contactMethods={contactMethods}
  />
</BaseLayout>
