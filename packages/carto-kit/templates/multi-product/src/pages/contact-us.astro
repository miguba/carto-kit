---
import PolicyPage from "@/components/PolicyPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import defaultPolicyMarkdown from "@/content/policies/contact-us.md?raw";
import { getSiteConfigFromServer } from "@/lib/commerce";
import { loadPolicyBlock } from "@/lib/policy-block";
import { siteAbsoluteUrl } from "@/lib/seo";

export const prerender = false;

const POLICY_BLOCK_KEY = "contact-us";

const site = await getSiteConfigFromServer();
const canonicalUrl = siteAbsoluteUrl("/contact-us", site.domain, Astro.url.origin);

const contactMethods = [
  { label: "Email", value: site.supportEmail, href: `mailto:${site.supportEmail}` },
  { label: "Response time", value: "1-2 business days" },
  { label: "Policy help", value: "Return policy", href: "/cancellation-refund-policy" },
];

const policy = await loadPolicyBlock({
  key: POLICY_BLOCK_KEY,
  defaultMarkdown: defaultPolicyMarkdown,
  fallbackTitle: "Contact Us",
  fallbackIntro:
    "Need help with an order or a policy question? Send us the details and we will help you find the cleanest path forward.",
  fallbackDescription: `Contact ${site.name} support for order help, payment questions, delivery updates, and refund requests.`,
  siteName: site.name,
});

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteAbsoluteUrl("/", site.domain, Astro.url.origin),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: policy.title,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={`${policy.seoTitle} | ${site.name}`}
  description={policy.pageDescription}
  canonicalUrl={canonicalUrl}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <PolicyPage
    eyebrow={policy.eyebrow}
    title={policy.title}
    intro={policy.intro}
    updated={policy.updated}
    contentHtml={policy.contentHtml}
    contentHeadings={policy.contentHeadings}
    asideTitle={policy.asideTitle}
    asideText={policy.asideText}
    contactMethods={contactMethods}
  />
</BaseLayout>
