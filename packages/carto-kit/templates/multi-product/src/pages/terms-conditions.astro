---
import PolicyPage from "@/components/PolicyPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import defaultPolicyMarkdown from "@/content/policies/terms-conditions.md?raw";
import { getSiteConfigFromServer } from "@/lib/commerce";
import { loadPolicyBlock } from "@/lib/policy-block";
import { siteAbsoluteUrl } from "@/lib/seo";

export const prerender = false;

const POLICY_BLOCK_KEY = "terms-conditions";

const refreshCache = Astro.url.searchParams.get("___refresh___") === "1";
const site = await getSiteConfigFromServer({ refresh: refreshCache });
const canonicalUrl = siteAbsoluteUrl("/terms-conditions", site.domain, Astro.url.origin);

const contactMethods = [
  {
    label: "Customer support",
    value: site.supportEmail,
    href: `mailto:${site.supportEmail}`,
  },
  { label: "Policies", value: "Return policy", href: "/cancellation-refund-policy" },
];

const policy = await loadPolicyBlock({
  key: POLICY_BLOCK_KEY,
  defaultMarkdown: defaultPolicyMarkdown,
  fallbackTitle: "Terms & Conditions",
  fallbackIntro:
    "These terms explain the rules that apply when you browse our store, place an order, complete payment, or request support.",
  fallbackDescription: `Read the ${site.name} terms for orders, payment, delivery, customer responsibilities, and refunds.`,
  siteName: site.name,
  refresh: refreshCache,
});

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteAbsoluteUrl("/", site.domain, Astro.url.origin),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: policy.title,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={`${policy.seoTitle} | ${site.name}`}
  description={policy.pageDescription}
  canonicalUrl={canonicalUrl}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <PolicyPage
    eyebrow={policy.eyebrow}
    title={policy.title}
    intro={policy.intro}
    updated={policy.updated}
    contentHtml={policy.contentHtml}
    contentHeadings={policy.contentHeadings}
    asideTitle={policy.asideTitle}
    asideText={policy.asideText}
    contactMethods={contactMethods}
  />
</BaseLayout>
