---
import ProductPurchasePanel from "@/components/ProductPurchasePanel";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getCommerceConfigFromServer,
  getProducts,
} from "@/lib/commerce";
import { cachePage } from "@/lib/cache-page";
import { getPageCacheBinding } from "@/lib/page-cache-binding";
import { getCachedProduct } from "@/lib/product-cache";
import {
  IMAGE_PRESETS,
  formatMoney,
  imagePlaceholderStyle,
  imageSrcSet,
  normalizeImageUrl,
  optimizedImageUrl,
  productAttributes,
  productCardPrice,
  productDescriptionMarkdown,
  productImages,
  productReviews,
  productSellingPoints,
  productTrustSignals,
} from "@/lib/format";
import { markdownToPlainText, renderMarkdown } from "@/lib/markdown";
import type { Product } from "@/lib/types";

export const prerender = false;

type ProductCacheData = {
  commerceConfig: Awaited<ReturnType<typeof getCommerceConfigFromServer>>;
  product: Product | null;
  relatedProducts: Product[];
};

const slug = String(Astro.params.slug ?? "");
let product: Product | null = null;
let relatedProducts: Product[] = [];
let loadError = "";
let commerceConfig: ProductCacheData["commerceConfig"];
const pageCacheBinding = await getPageCacheBinding();
const refreshCache = Astro.url.searchParams.get("___refresh___") === "1";

try {
  if (!slug) {
    loadError = "Missing product slug.";
  } else {
    const { data } = await cachePage<ProductCacheData>(`page:product:${slug}`, {
      async fun() {
        const cacheOptions = {
          refresh: refreshCache,
          kvCache: pageCacheBinding,
        };
        const [commerceConfig, product, products] = await Promise.all([
          getCommerceConfigFromServer(cacheOptions),
          getCachedProduct(slug, cacheOptions),
          getProducts(8, cacheOptions),
        ]);

        return {
          commerceConfig,
          product,
          relatedProducts: products
            .filter((item) => item.slug !== product?.slug)
            .slice(0, 4),
        };
      },
      refresh: refreshCache,
      kvCache: pageCacheBinding,
    });

    commerceConfig = data.commerceConfig;
    product = data.product;
    relatedProducts = data.relatedProducts;

    if (!product) {
      loadError = "Missing product slug.";
    }
  }
} catch (error) {
  loadError =
    error instanceof Error ? error.message : "Unable to load product.";
}

commerceConfig ??= await getCommerceConfigFromServer({
  refresh: refreshCache,
  kvCache: pageCacheBinding,
});
const site = commerceConfig.site;

const images = product ? productImages(product) : [];
const sellingPoints = product ? productSellingPoints(product) : [];
const attributes = product ? Object.entries(productAttributes(product)) : [];
const reviews = product ? productReviews(product) : [];
const ratedReviews = reviews.filter((review) => typeof review.rating === "number");
const averageRating = ratedReviews.length
  ? ratedReviews.reduce((sum, review) => sum + (review.rating ?? 0), 0) /
    ratedReviews.length
  : null;
const description = product ? productDescriptionMarkdown(product) : "";
const descriptionHtml = description
  ? renderMarkdown(description, { headingOffset: 1 })
  : "";
const descriptionText = description ? markdownToPlainText(description) : "";
const productSeo = product?.meta?.seo ?? {};
const pageTitle = product
  ? `${cleanText(productSeo.title) || product.title} | ${site.name}`
  : `Product Detail | ${site.name}`;
const pageDescription = product
  ? cleanText(productSeo.description) ||
    cleanText(descriptionText) ||
    cleanText(sellingPoints[0]) ||
    product.title
  : `${site.name} product detail page.`;
const seoImage = product
  ? toAbsoluteUrl(
      normalizedImage(productSeo.image) || images[0] || "",
      site.domain,
      Astro.url.origin,
    )
  : "";
const productPath = product
  ? normalizedCanonicalPath(productSeo.canonicalPath) || `/products/${product.slug}`
  : Astro.url.pathname;
const canonicalUrl = toAbsoluteUrl(productPath, site.domain, Astro.url.origin);
const keywords = product
  ? uniqueStrings([...(productSeo.keywords ?? []), ...product.tags])
  : [];
const optionNames = product
  ? Array.from(
      new Set(
        product.variants.flatMap((variant) =>
          Object.keys(variant.optionValues),
        ),
      ),
    )
  : [];
const lowestVariant = product?.variants.reduce(
  (lowest, variant) => (variant.price < lowest.price ? variant : lowest),
  product.variants[0],
);
const schema =
  product && lowestVariant
    ? {
        "@context": "https://schema.org",
        "@type": "Product",
        name: cleanText(productSeo.title) || product.title,
        image: uniqueStrings([
          seoImage,
          ...images.map((image) =>
            toAbsoluteUrl(image, site.domain, Astro.url.origin),
          ),
        ]),
        description: pageDescription,
        sku: lowestVariant.sku,
        brand: {
          "@type": "Brand",
          name: site.name,
        },
        offers: {
          "@type": "Offer",
          url: canonicalUrl,
          priceCurrency: product.currency,
          price:
            product.currency === "JPY"
              ? lowestVariant.price
              : lowestVariant.price / 100,
          availability:
            product.totalStock > 0
              ? "https://schema.org/InStock"
              : "https://schema.org/OutOfStock",
        },
        ...(averageRating
          ? {
              aggregateRating: {
                "@type": "AggregateRating",
                ratingValue: Number(averageRating.toFixed(1)),
                reviewCount: reviews.length,
              },
              review: reviews.slice(0, 5).map((review) => ({
                "@type": "Review",
                author: {
                  "@type": "Person",
                  name: review.author || "Customer",
                },
                reviewBody: cleanText(review.content),
                ...(typeof review.rating === "number"
                  ? {
                      reviewRating: {
                        "@type": "Rating",
                        ratingValue: review.rating,
                        bestRating: 5,
                      },
                    }
                  : {}),
              })),
            }
          : {}),
      }
    : null;
const breadcrumbSchema =
  product
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: toAbsoluteUrl("/", site.domain, Astro.url.origin),
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Products",
            item: toAbsoluteUrl("/#products", site.domain, Astro.url.origin),
          },
          {
            "@type": "ListItem",
            position: 3,
            name: product.title,
            item: canonicalUrl,
          },
        ],
      }
    : null;

function cleanText(value: unknown) {
  return typeof value === "string" ? value.replace(/\s+/g, " ").trim() : "";
}

function uniqueStrings(values: Array<string | null | undefined>) {
  return Array.from(new Set(values.map(cleanText).filter(Boolean)));
}

function normalizedImage(value: unknown) {
  const text = cleanText(value);
  if (!text) {
    return "";
  }

  if (/^(https?:|\/)/.test(text)) {
    return text;
  }

  return normalizeImageUrl(text);
}

function normalizedCanonicalPath(value: unknown) {
  const text = cleanText(value);
  if (!text) {
    return "";
  }

  if (/^https?:\/\//.test(text)) {
    return text;
  }

  return text.startsWith("/") ? text : `/${text}`;
}

function toAbsoluteUrl(value: string, domain: string, fallbackOrigin: string) {
  if (!value) {
    return "";
  }

  if (/^https?:\/\//.test(value)) {
    return value;
  }

  const origin = domain
    ? /^https?:\/\//.test(domain)
      ? domain.replace(/\/+$/, "")
      : `https://${domain.replace(/\/+$/, "")}`
    : fallbackOrigin.replace(/\/+$/, "");

  return `${origin}${value.startsWith("/") ? value : `/${value}`}`;
}

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={seoImage}
  keywords={keywords}
  noindex={Boolean(productSeo.noindex)}
  type="product"
>
  {
    product ? (
      <>
        {schema ? (
          <>
            <script
              is:inline
              type="application/ld+json"
              set:html={JSON.stringify(schema)}
            />
            {breadcrumbSchema ? (
              <script
                is:inline
                type="application/ld+json"
                set:html={JSON.stringify(breadcrumbSchema)}
              />
            ) : null}
          </>
        ) : null}

        <ProductPurchasePanel product={product} mediaConfig={commerceConfig.media} client:load />

        {description ||
        attributes.length ||
        optionNames.length ||
        images.length ||
        reviews.length ? (
          <section class="section product-description-section">
            <div class="container product-description-grid">
              <article>
                <p class="eyebrow">Description</p>
                <h2>Product Details</h2>
                {descriptionHtml ? (
                  <div
                    class="product-description-content"
                    set:html={descriptionHtml}
                  />
                ) : (
                  <p>
                    No additional details are available for this product yet.
                  </p>
                )}
              </article>
              <article>
                <p class="eyebrow">Specifications</p>
                <h2>Product Attributes</h2>
                <dl class="dl-list">
                  {attributes.length ? (
                    attributes.map(([key, value]) => (
                      <div>
                        <dt>{key}</dt>
                        <dd>{value}</dd>
                      </div>
                    ))
                  ) : (
                    <>
                      <div>
                        <dt>Variant options</dt>
                        <dd>
                          {optionNames.length
                            ? optionNames.join(", ")
                            : `${product.variants.length} options available`}
                        </dd>
                      </div>
                      {images.length ? (
                        <div>
                          <dt>Gallery</dt>
                          <dd>{`${images.length} product image${images.length === 1 ? "" : "s"}`}</dd>
                        </div>
                      ) : null}
                    </>
                  )}
                </dl>
                {reviews.length ? (
                  <section class="product-reviews-panel" aria-labelledby="product-reviews-title">
                    <div class="product-reviews-summary">
                      <div>
                        <p class="eyebrow">Customer Reviews</p>
                        <h3 id="product-reviews-title">Real Buyer Feedback</h3>
                      </div>
                      {averageRating ? (
                        <div class="product-reviews-score" aria-label={`${averageRating.toFixed(1)} out of 5 stars`}>
                          <span aria-hidden="true">★★★★★</span>
                          <strong>{averageRating.toFixed(1)}</strong>
                          <em>{`${reviews.length} review${reviews.length === 1 ? "" : "s"}`}</em>
                        </div>
                      ) : (
                        <div class="product-reviews-score">
                          <strong>{reviews.length}</strong>
                          <em>{`review${reviews.length === 1 ? "" : "s"}`}</em>
                        </div>
                      )}
                    </div>
                    <div class="product-review-list">
                      {reviews.slice(0, 6).map((review, index) => (
                        <article class="product-review-card">
                          <div class="product-review-header">
                            <div class="product-review-avatar">
                              {review.avatar ? (
                                <img
                                  src={review.avatar}
                                  alt={review.author ? `${review.author} avatar` : "Reviewer avatar"}
                                  loading="lazy"
                                  decoding="async"
                                />
                              ) : (
                                <span>{review.author?.slice(0, 1).toUpperCase() || "C"}</span>
                              )}
                            </div>
                            <div>
                              <h4>{review.author || `Customer ${index + 1}`}</h4>
                              {(review.date || review.purchased) ? (
                                <p>{[review.date, review.purchased].filter(Boolean).join(" / ")}</p>
                              ) : null}
                            </div>
                            {typeof review.rating === "number" ? (
                              <div class="product-review-rating" aria-label={`${review.rating} out of 5 stars`}>
                                <span aria-hidden="true">★★★★★</span>
                                <strong>{review.rating.toFixed(review.rating % 1 ? 1 : 0)}</strong>
                              </div>
                            ) : null}
                          </div>
                          {review.title ? <h5>{review.title}</h5> : null}
                          <p>{review.content}</p>
                          {review.images?.length ? (
                            <div class="product-review-images">
                              {review.images.slice(0, 4).map((image, imageIndex) => (
                                <img
                                  src={optimizedImageUrl(image, IMAGE_PRESETS.thumb)}
                                  alt={`${review.author || "Customer"} review image ${imageIndex + 1}`}
                                  loading="lazy"
                                  decoding="async"
                                />
                              ))}
                            </div>
                          ) : null}
                          {typeof review.helpfulCount === "number" ? (
                            <small>{`${review.helpfulCount} found this helpful`}</small>
                          ) : null}
                        </article>
                      ))}
                    </div>
                  </section>
                ) : null}
              </article>
            </div>
          </section>
        ) : null}

        {relatedProducts.length ? (
          <section class="section-tight">
            <div class="container section-header catalog-heading">
              <div>
                <p class="eyebrow">Keep Browsing</p>
                <h2>You May Also Like</h2>
              </div>
              <p>Explore more curated creations from the {site.name} gallery.</p>
            </div>
            <div class="container grid grid-cols-1 sm:grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-6">
              {relatedProducts.map((item) => {
                const image = productImages(item)[0];
                const trust = productTrustSignals(item);
                const price = productCardPrice(item);
                const sellingPoint = productSellingPoints(item)[0];

                return (
                <a class="catalog-card" href={`/products/${item.slug}`}>
                  <div
                    class="media-frame catalog-card-art image-placeholder-frame"
                    style={image ? imagePlaceholderStyle(image) : undefined}
                  >
                    {image ? (
                      <img
                        src={optimizedImageUrl(image, IMAGE_PRESETS.card)}
                        srcset={imageSrcSet(image, [360, 480, 720], { quality: IMAGE_PRESETS.card.quality })}
                        sizes="(min-width: 640px) 280px, calc(100vw - 32px)"
                        alt={item.title}
                        loading="lazy"
                        decoding="async"
                        fetchpriority="low"
                      />
                    ) : (
                      <span class="w-16 h-16 text-2xl" aria-hidden="true">
                        {item.title.slice(0, 1).toUpperCase()}
                      </span>
                    )}
                  </div>
                  <div class="catalog-card-trust" aria-label={`${trust.rating} stars, ${trust.soldText}`}>
                    <span aria-hidden="true">★★★★★</span>
                    <strong>{trust.rating}</strong>
                    <em>{trust.soldText}</em>
                  </div>
                  <div class="catalog-card-body grid gap-2">
                    <h3>{item.title}</h3>
                    {sellingPoint ? <p>{sellingPoint}</p> : null}
                  </div>
                  <div class="catalog-card-footer mt-auto pt-3 border-t border-line">
                    <div class="catalog-price-stack">
                      <strong>{formatMoney(price.price, item.currency)}</strong>
                      {price.compareAtPrice ? (
                        <span>
                          <del>{formatMoney(price.compareAtPrice, item.currency)}</del>
                          {price.discountPercent ? <em>{price.discountPercent}% off</em> : null}
                        </span>
                      ) : null}
                    </div>
                  </div>
                </a>
                );
              })}
            </div>
          </section>
        ) : null}

        <section class="product-page-footer-nav">
          <nav class="container product-breadcrumbs" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              <li><a href="/#products">Collections</a></li>
              <li aria-current="page">{product.title}</li>
            </ol>
          </nav>
        </section>
      </>
    ) : (
      <section class="error-state">
        <div class="panel error-panel max-w-2xl text-center">
          <p class="eyebrow">Product unavailable</p>
          <h1>We could not load this product.</h1>
          <p>{loadError}</p>
          <a class="primary-button" href="/">
            Back to products
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>
