{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "__APP_NAME__",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_NAME": "__APP_NAME__"
  }
}
