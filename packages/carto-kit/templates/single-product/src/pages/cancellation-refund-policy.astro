---
import PolicyPage from '@/components/PolicyPage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import defaultPolicyMarkdown from '@/content/policies/cancellation-refund-policy.md?raw';
import { getCommerceConfigFromServer } from '@/lib/commerce';
import { loadPolicyBlock } from '@/lib/policy-block';

const POLICY_BLOCK_KEY = 'cancellation-refund-policy';

const { site } = await getCommerceConfigFromServer();

const policy = await loadPolicyBlock({
  key: POLICY_BLOCK_KEY,
  defaultMarkdown: defaultPolicyMarkdown,
  fallbackTitle: 'Cancellation & Refund Policy',
  fallbackIntro:
    'A clear guide to when orders can be cancelled, how refund requests are reviewed, and what to expect after a request is approved.',
  fallbackDescription: `Review ${site.name} cancellation, refund eligibility, refund timing, and dispute handling policies.`,
  siteName: site.name,
  variables: {
    siteName: site.name,
    supportEmail: site.supportEmail,
  },
});
---

<BaseLayout
  title={`${policy.seoTitle} | ${site.name}`}
  description={policy.pageDescription}
  canonicalPath="/cancellation-refund-policy"
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: policy.title,
    description: policy.pageDescription,
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
        { '@type': 'ListItem', position: 2, name: policy.title },
      ],
    },
  }]}
>
  <PolicyPage
    eyebrow={policy.eyebrow}
    title={policy.title}
    intro={policy.intro}
    updated={policy.updated}
    contentHtml={policy.contentHtml}
    contentHeadings={policy.contentHeadings}
    asideTitle={policy.asideTitle}
    asideText={policy.asideText}
    contactMethods={policy.contactMethods}
  />
</BaseLayout>
