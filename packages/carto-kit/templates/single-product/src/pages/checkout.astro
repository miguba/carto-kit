---
import CheckoutForm from '@/components/CheckoutForm';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getCachedCommerceConfigFromServer,
  getCachedProduct,
} from '@/lib/commerce';
import { getCommerceConfig } from '@/lib/config';
import { getPageCacheBinding } from '@/lib/page-cache-binding';
import type { Product, ProductVariant } from '@/lib/types';

export const prerender = false;

const slug = Astro.url.searchParams.get('slug') || '';
const sku = Astro.url.searchParams.get('sku') || '';
const quantity = Math.max(
  1,
  Number(Astro.url.searchParams.get('quantity') || '1'),
);
const { mapboxAccessToken } = getCommerceConfig();
const refreshCache = Astro.url.searchParams.get('___refresh___') === '1';
const pageCacheBinding = await getPageCacheBinding();

let product: Product | null = null;
let variant: ProductVariant | null = null;
let paypalClientId = '';
let checkoutError = '';

if (!slug || !sku || !Number.isInteger(quantity) || quantity < 1) {
  checkoutError = 'Missing or invalid checkout selection.';
} else {
  try {
    const [config, loadedProduct] = await Promise.all([
      getCachedCommerceConfigFromServer({
        refresh: refreshCache,
        kvCache: pageCacheBinding,
      }),
      getCachedProduct(slug, {
        refresh: refreshCache,
        kvCache: pageCacheBinding,
      }),
    ]);

    paypalClientId = config.payments.paypal.clientId;
    product = loadedProduct;
    variant =
      product.variants.find((item) => item.sku === sku) ??
      product.variants.find(
        (item) => normalizeSku(item.sku) === normalizeSku(sku),
      ) ??
      null;

    if (!variant) {
      checkoutError = `SKU "${sku}" is not available for this product.`;
    }
  } catch (error) {
    console.error('Failed to prepare checkout:', error);
    checkoutError =
      error instanceof Error ? error.message : 'Unable to prepare checkout.';
  }
}

function normalizeSku(value: string) {
  return value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
}
---

<BaseLayout
  checkoutOnly
  title="Secure Checkout | 365 Deal"
  description="Complete your Microsoft 365 order with PayPal protected checkout."
  noindex
>
  {
    product && variant && !checkoutError ? (
      <section>
        <div class="mx-auto w-[min(1160px,calc(100%-32px))]">
          <CheckoutForm
            product={product}
            variant={variant}
            quantity={quantity}
            paypalClientId={paypalClientId}
            mapboxAccessToken={mapboxAccessToken}
            client:load
          />
        </div>
      </section>
    ) : (
      <section class="grid min-h-[62vh] place-items-center px-4 py-12">
        <div class="max-w-[620px] rounded-brand border border-line bg-white p-8 shadow-soft-card">
          <p class="mb-3.5 mt-0 text-[0.78rem] font-extrabold uppercase tracking-[0.08em] text-brand">
            Checkout Unavailable
          </p>
          <h1 class="mb-3 mt-0 text-[clamp(2rem,7vw,4rem)] leading-none">
            Checkout is temporarily unavailable.
          </h1>
          <p class="text-muted leading-relaxed">
            Please return to the product page and try again in a moment. If the
            issue continues, contact support and we will help you complete your
            order.
          </p>
          {import.meta.env.DEV && checkoutError ? (
            <p class="text-muted leading-relaxed">
              Development detail: {checkoutError}
            </p>
          ) : null}
          <a
            class="inline-flex min-h-12 items-center justify-center rounded-brand bg-brand px-[18px] font-extrabold text-white no-underline shadow-[0_16px_40px_rgba(35,100,232,0.26)] hover:bg-brand-strong"
            href="/"
          >
            Return to Store
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>
