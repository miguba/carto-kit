{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carto-kit.dev/schema/contract-bundle-v1.schema.json",
  "title": "Carto Contract Bundle envelope v1",
  "type": "object",
  "required": ["schemaVersion", "contractVersion", "bundle"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "contractVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "bundle": { "type": "object" }
  },
  "additionalProperties": true
}
