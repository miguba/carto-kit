---
import { getInventoryLabel, getProductImages, getProductPrice } from "../lib/products";
import type { Product } from "../lib/types";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const [image] = getProductImages(product);
---
<a class="product-card" href={`/products/${product.slug}`}>
  <div class="product-card__media">
    {image ? <img src={image.url} alt={image.alt || product.title} loading="lazy" /> : <div class="image-placeholder">No image</div>}
  </div>
  <div class="product-card__body">
    <p class="eyebrow">{getInventoryLabel(product)}</p>
    <h2>{product.title}</h2>
    <p>{product.summary || product.description || "View product details and checkout options."}</p>
    <strong>{getProductPrice(product)}</strong>
  </div>
</a>
