---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteConfig } from '@/lib/config';

const site = getSiteConfig();
---

<BaseLayout
  title={`${site.name} | 开箱即用的美学在线商店系统`}
  description="面向个人创作者与轻量级商家的极致独立站系统，开启你的盒子，向世界传递惊喜。"
>
  <div class="wb-theme-wrapper">
    <!-- Google Fonts Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Hero Section -->
    <section class="wb-hero">
      <div class="wb-hero-glow"></div>
      <div class="wb-container">
        <div class="wb-hero-content">
          <div class="wb-badge">
            <span class="wb-badge-dot"></span>
            <span>{site.name} 品牌官方行销计划已上线</span>
          </div>
          <h1 class="wb-title">
            Unbox Your Shop.<br/>
            <span class="wb-gradient-text">Deliver the Joy.</span>
          </h1>
          <p class="wb-subtitle">
            {site.name} 是一款面向用户的极简、美观且极速的在线商店系统。<br/>
            专为个人创作者、手作匠人与独立品牌量身打造，以最纯粹的盒子，承载你的奇迹。
          </p>
          <div class="wb-actions">
            <a href="#simulator" class="wb-btn-primary">
              <span>行销收益模拟器</span>
              <svg class="wb-arrow" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/" class="wb-btn-secondary">探索演示商店</a>
          </div>
        </div>

        <!-- 3D style Floating Box Visual -->
        <div class="wb-hero-visual">
          <div class="wb-box-container">
            <div class="wb-box-face wb-front">
              <div class="wb-box-logo">J</div>
            </div>
            <div class="wb-box-face wb-back"></div>
            <div class="wb-box-face wb-right"></div>
            <div class="wb-box-face wb-left"></div>
            <div class="wb-box-face wb-top"></div>
            <div class="wb-box-face wb-bottom"></div>
            <div class="wb-box-glow"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Three Pillars Section -->
    <section class="wb-pillars" id="pillars">
      <div class="wb-container">
        <div class="wb-section-header">
          <h2 class="wb-section-title">核心品牌支柱</h2>
          <p class="wb-section-desc">为什么选择 {site.name}？我们重新思考了独立站的搭建与买家体验。</p>
        </div>

        <div class="wb-grid-3">
          <div class="wb-card">
            <div class="wb-card-icon-box purple">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                <line x1="12" y1="22.08" x2="12" y2="12"/>
              </svg>
            </div>
            <h3>Unbox / 拆箱即用</h3>
            <p>1分钟一键在云端部署，零门槛生成精美的独立站前端。告别繁琐的服务器配置与冗余的插件堆砌。</p>
          </div>

          <div class="wb-card">
            <div class="wb-card-icon-box pink">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
            </div>
            <h3>Fill / 极致装载</h3>
            <p>基于现代无头电商 (Headless) 架构，通过优雅而强大的 API 管理您的产品、规格与库存，把创意装进魔盒。</p>
          </div>

          <div class="wb-card">
            <div class="wb-card-icon-box green">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                <line x1="1" y1="10" x2="23" y2="10"/>
              </svg>
            </div>
            <h3>Deliver / 安全传递</h3>
            <p>极其流畅的安全结账流，支持多种主流收款方式，配合极致的静态页面加载性能，提升买家的付款转化率，减少购物车流失。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Marketing Simulator Section -->
    <section class="wb-simulator-section" id="simulator">
      <div class="wb-container">
        <div class="wb-simulator-grid">
          <div class="wb-simulator-copy">
            <div class="wb-badge pink">
              <span>Dynamic Hack</span>
            </div>
            <h2 class="wb-section-title">行销与裂变模拟器</h2>
            <p class="wb-section-desc">
              {site.name} 独创的 <strong>“Powered by {site.name}”</strong> 底部徽标裂变机制，能将每一个买家转化为你的潜在分销人。
            </p>
            <p class="wb-text">
              在右侧输入您的预估数据，实时模拟通过裂变机制、Instagram 网红推广和独立站冷启动所能带来的转化成效。
            </p>
            
            <div class="wb-features-list">
              <div class="wb-feature-item">
                <span class="wb-feature-check">✓</span>
                <div>
                  <strong>“Powered by” 徽标裂变：</strong>
                  <span>买家在结账后点击商店底部的徽标注册新商店，您可获得佣金分成与免息额度。</span>
                </div>
              </div>
              <div class="wb-feature-item">
                <span class="wb-feature-check">✓</span>
                <div>
                  <strong>独立创作者联盟：</strong>
                  <span>与同类型手作博主交叉推广，通过 API 实现商品联营。</span>
                </div>
              </div>
            </div>
          </div>

          <div class="wb-simulator-card">
            <h3>{site.name} 增长模拟</h3>
            
            <div class="wb-control-group">
              <label for="daily-visitors">日均商店访客数</label>
              <div class="wb-range-wrapper">
                <input type="range" id="daily-visitors" min="50" max="5000" step="50" value="500" />
                <span id="visitors-val" class="wb-range-bubble">500</span>
              </div>
            </div>

            <div class="wb-control-group">
              <label for="avg-price">商品客单价 (USD)</label>
              <div class="wb-range-wrapper">
                <input type="range" id="avg-price" min="10" max="500" step="5" value="49" />
                <span id="price-val" class="wb-range-bubble">$49</span>
              </div>
            </div>

            <div class="wb-control-group">
              <label for="referral-rate">底部徽标裂变转化率</label>
              <div class="wb-range-wrapper">
                <input type="range" id="referral-rate" min="0.1" max="5" step="0.1" value="1.2" />
                <span id="referral-val" class="wb-range-bubble">1.2%</span>
              </div>
            </div>

            <div class="wb-divider"></div>

            <div class="wb-results">
              <div class="wb-result-item">
                <span class="wb-result-label">月预估销售额</span>
                <strong id="res-revenue" class="wb-gradient-text">$7,350</strong>
              </div>
              <div class="wb-result-item">
                <span class="wb-result-label">月裂变新商家数</span>
                <strong id="res-merchants" class="wb-text-purple">180 家</strong>
              </div>
              <div class="wb-result-item">
                <span class="wb-result-label">预计节省佣金/收益返利</span>
                <strong id="res-bonus" class="wb-text-green">$360</strong>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Marketing Plan Summary Artifact Link -->
    <section class="wb-cta">
      <div class="wb-container wb-cta-inner">
        <h2 class="wb-cta-title">获取完整的品牌行销策划方案</h2>
        <p class="wb-cta-desc">我们已为您梳理出一份包含品牌冷启动、社交媒体 KOL 推广、增长裂变机制以及视觉规范的完整方案文档。</p>
        <div class="wb-cta-buttons">
          <a href="/Users/worker/.gemini/antigravity/brain/2f8b4efc-7247-41f4-aa72-49cd68e2bc8a/wonder_box_brand_marketing_plan.md" class="wb-btn-primary pink-btn">查看完整策划案</a>
          <a href="#simulator" class="wb-btn-text">调整增长参数</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<!-- Client Side Interaction Script -->
<script>
  function updateSimulator() {
    const visitorsInput = document.getElementById('daily-visitors') as HTMLInputElement;
    const priceInput = document.getElementById('avg-price') as HTMLInputElement;
    const referralInput = document.getElementById('referral-rate') as HTMLInputElement;

    const visitorsVal = document.getElementById('visitors-val');
    const priceVal = document.getElementById('price-val');
    const referralVal = document.getElementById('referral-val');

    const resRevenue = document.getElementById('res-revenue');
    const resMerchants = document.getElementById('res-merchants');
    const resBonus = document.getElementById('res-bonus');

    if (!visitorsInput || !priceInput || !referralInput) return;

    const visitors = parseInt(visitorsInput.value);
    const price = parseInt(priceInput.value);
    const referral = parseFloat(referralInput.value);

    // Update range labels
    if (visitorsVal) visitorsVal.textContent = visitors.toString();
    if (priceVal) priceVal.textContent = `$${price}`;
    if (referralVal) referralVal.textContent = `${referral}%`;

    // Calculation logic
    // Assume average conversion rate is 2%
    const monthlyOrders = Math.round(visitors * 30 * 0.02);
    const monthlyRevenue = monthlyOrders * price;
    
    // Referral conversion
    const monthlyReferrals = Math.round(monthlyOrders * (referral / 100));
    
    // Monthly bonus: assume $10 bonus per referred merchant + 1% fee reduction
    const monthlyBonus = Math.round(monthlyReferrals * 15 + monthlyRevenue * 0.01);

    // Update result UI
    if (resRevenue) resRevenue.textContent = `$${monthlyRevenue.toLocaleString()}`;
    if (resMerchants) resMerchants.textContent = `${monthlyReferrals} 家`;
    if (resBonus) resBonus.textContent = `$${monthlyBonus.toLocaleString()}`;
  }

  // Initialize listeners
  const inputs = ['daily-visitors', 'avg-price', 'referral-rate'];
  inputs.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', updateSimulator);
    }
  });

  // Run once initially
  updateSimulator();
</script>

<style>
  /* Base style scope for the marketing landing page */
  .wb-theme-wrapper {
    background: #0b0813;
    color: #f3f4f6;
    font-family: 'Outfit', 'Inter', -apple-system, sans-serif;
    padding-bottom: 80px;
    overflow: hidden;
    margin-top: -20px; /* offset any body padding */
  }

  .wb-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 10;
  }

  .wb-gradient-text {
    background: linear-gradient(135deg, #8b5cf6 0%, #ec4899 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  /* Badge styling */
  .wb-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.2);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #a78bfa;
    margin-bottom: 24px;
  }

  .wb-badge.pink {
    background: rgba(236, 72, 153, 0.1);
    border-color: rgba(236, 72, 153, 0.2);
    color: #f472b6;
  }

  .wb-badge-dot {
    width: 6px;
    height: 6px;
    background-color: #a78bfa;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 10px #a78bfa;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.5; }
    100% { transform: scale(1); opacity: 1; }
  }

  /* Hero Section */
  .wb-hero {
    position: relative;
    padding: 120px 0 80px 0;
    min-height: 80vh;
    display: flex;
    align-items: center;
  }

  .wb-hero-glow {
    position: absolute;
    top: -10%;
    left: 30%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.15) 0%, rgba(236, 72, 153, 0.05) 50%, transparent 100%);
    filter: blur(80px);
    z-index: 1;
    pointer-events: none;
