  .wb-front  { transform: rotateY(0deg) translateZ(80px); border-color: #ec4899; }
  .wb-back   { transform: rotateY(180deg) translateZ(80px); }
  .wb-right  { transform: rotateY(90deg) translateZ(80px); }
  .wb-left   { transform: rotateY(-90deg) translateZ(80px); }
  .wb-top    { transform: rotateX(90deg) translateZ(80px); }
  .wb-bottom { transform: rotateX(-90deg) translateZ(80px); }

  .wb-box-glow {
    position: absolute;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(236, 72, 153, 0.4) 0%, transparent 70%);
    top: -20px;
    left: -20px;
    transform: translateZ(-100px);
    filter: blur(20px);
    pointer-events: none;
  }

  @keyframes rotateBox {
    from { transform: rotateX(0deg) rotateY(0deg); }
    to { transform: rotateX(360deg) rotateY(360deg); }
  }

  /* Pillars Section */
  .wb-pillars {
    padding: 80px 0;
    position: relative;
  }

  .wb-section-header {
    text-align: center;
    max-width: 600px;
